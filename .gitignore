# See https://www.dartlang.org/guides/libraries/private-files

# Files and directories created by pub
.dart_tool/
.packages
build/
# If you're building an application, you may want to check-in your pubspec.lock
pubspec.lock

# Directory created by dartdoc
# If you don't generate documentation locally you can remove this line.
doc/api/

# dotenv environment variables file
.env*

# Avoid committing generated Javascript files:
*.dart.js
# Produced by the --dump-info flag.
*.info.json
# When generated by dart2js. Don't specify *.js if your
# project includes source files written in JavaScript.
*.js
*.js_
*.js.deps
*.js.map

.flutter-plugins
.flutter-plugins-dependencies

# Spike intermediates. The exporter writes here; the copies the integration test
# actually loads live in the app's assets/ and are committed, so the test runs
# without a torch install.
examples/spike/build/

# build_runner bookkeeping. The generated .dart next to the manifest is
# committed on purpose; this is not.
.dart_tool/build/

# Python bytecode. Compiled files carry the absolute path of the machine that
# built them, which is not something a public repository should publish, and
# they were being committed because this file had no Python section at all.
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/

# Local Python environment for the export half. torch and executorch are
# several gigabytes and belong to the machine, not to the repository.
.venv/

# The cross-compiled binding, written here by tool/build_native.sh --android.
# 61 MB of build output that every machine reproduces from the same script, so
# committing it would put a binary in the history that nobody can diff.
packages/fluttorch_executorch_flutter/android/src/main/jniLibs/**/*.so
packages/fluttorch_executorch_flutter/ios/**/*.xcframework/
